# ============================================================
# Template .env untuk hosting Rumahweb (shared hosting cPanel)
# Salin ke .env di server, lalu isi nilai bertanda <<< GANTI >>>
# ============================================================

APP_NAME=CUANTAH
APP_ENV=production
# Isi dengan hasil `php artisan key:generate --show` (lihat panduan deploy)
APP_KEY=
APP_DEBUG=false
APP_URL=https://domainmu.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Simpan log harian dan buang yang lebih tua dari 14 hari, supaya
# kuota disk shared hosting tidak habis dimakan file log.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database MySQL dari cPanel. Nama database dan user biasanya
# otomatis berawalan nama akun cPanel, contoh: namaakun_cuantah
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=        # <<< GANTI >>>
DB_USERNAME=        # <<< GANTI >>>
DB_PASSWORD=        # <<< GANTI >>>

# Cookie sesi hanya dikirim lewat HTTPS. Aktifkan setelah SSL terpasang.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Aplikasi ini tidak punya job antrian, jadi sync aman dan
# tidak perlu menjalankan worker di shared hosting.
QUEUE_CONNECTION=sync

CACHE_STORE=database

# SMTP email hosting Rumahweb. Buat dulu akun email di cPanel,
# lalu pakai kredensialnya di sini. Tanpa ini, reset password
# tidak akan pernah sampai ke pengguna.
MAIL_MAILER=smtp
MAIL_HOST=mail.domainmu.com   # <<< GANTI >>>
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=noreply@domainmu.com   # <<< GANTI >>>
MAIL_PASSWORD=                        # <<< GANTI >>>
MAIL_FROM_ADDRESS="noreply@domainmu.com"   # <<< GANTI >>>
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
